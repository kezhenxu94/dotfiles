#!/bin/sh

if ! grep -q "host.docker.internal" /etc/hosts; then
  echo "host.docker.internal not found in /etc/hosts"
  exit 1
fi

setup() {
  networksetup -setwebproxy Wi-Fi host.docker.internal 7890
  networksetup -setsecurewebproxy Wi-Fi host.docker.internal 7890
  networksetup -setsocksfirewallproxy Wi-Fi host.docker.internal 7891
  networksetup -setproxybypassdomains wi-Fi host.docker.internal 127.0.0.1 *.apple.com localhost local-docker-registry 192.* *.local *.test
  networksetup -setdnsservers Wi-Fi 127.0.0.1

  networksetup -setwebproxy F50 host.docker.internal 7890
  networksetup -setsecurewebproxy F50 host.docker.internal 7890
  networksetup -setsocksfirewallproxy F50 host.docker.internal 7891
  networksetup -setproxybypassdomains F50 host.docker.internal 127.0.0.1 *.apple.com localhost local-docker-registry 192.* *.local *.test
  networksetup -setdnsservers F50 127.0.0.1
}

teardown() {
  networksetup -setwebproxystate wi-fi off
  networksetup -setsecurewebproxystate wi-fi off
  networksetup -setsocksfirewallproxystate wi-fi off
  networksetup -setproxybypassdomains wi-fi Empty
  networksetup -setdnsservers Wi-Fi Empty

  networksetup -setwebproxystate F50 off
  networksetup -setsecurewebproxystate F50 off
  networksetup -setsocksfirewallproxystate F50 off
  networksetup -setproxybypassdomains F50 Empty
  networksetup -setdnsservers F50 Empty
}

trap teardown EXIT

setup

~/usr/local/xray/xray -c ~/.config/v2ray/config.yaml
