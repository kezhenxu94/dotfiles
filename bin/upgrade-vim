#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
INSTALL_DIR="$SCRIPT_DIR/packages/install"

source "$INSTALL_DIR/lib/env.sh"
source "$INSTALL_DIR/lib/helpers.sh"

VIM_VERSION="${VIM_VERSION:-latest}" \
  source "$INSTALL_DIR/packages/51-vim.sh"
