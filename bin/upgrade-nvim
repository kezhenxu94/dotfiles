#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INSTALL_DIR="$SCRIPT_DIR/packages/install"

source "$INSTALL_DIR/lib/env.sh"
source "$INSTALL_DIR/lib/helpers.sh"

NVIM_FORCE=true NVIM_VERSION="${NVIM_VERSION:-latest}" \
  source "$INSTALL_DIR/packages/50-nvim.sh"
